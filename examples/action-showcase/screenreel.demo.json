{
  "schemaVersion": 1,
  "flows": [
    {
      "id": "guided-tour", "name": "Guided product tour", "defaults": { "dwellMs": 650, "settleMs": 150 },
      "scenes": [
        { "id": "tour-opening", "enabled": true, "route": "./", "title": "The story in one flow", "talkingPoints": "The hero card is the flow: highlight the story, interact with the UI, capture and share.", "narration": "", "actions": [
          { "type": "countdown", "from": 3, "stepMs": 550, "caption": "Your demo is about to play", "note": "Ready…", "narration": "This is ScreenReel, running live." },
          { "type": "highlight", "selector": "[data-flow-step=\"1\"]", "holdMs": 1500, "afterMs": 250, "note": "Highlight the story", "narration": "First, tell the story." },
          { "type": "highlight", "selector": "[data-flow-step=\"2\"]", "holdMs": 1500, "afterMs": 250, "note": "Interact with the UI", "narration": "Then drive the real product." },
          { "type": "highlight", "selector": "[data-flow-step=\"3\"]", "holdMs": 1500, "afterMs": 300, "note": "Capture and share", "narration": "Then capture and share it." }
        ]},
        { "id": "tour-why", "enabled": true, "route": "./", "title": "Why we built it", "talkingPoints": "Demos should not drift every time the product changes.", "narration": "", "actions": [
          { "type": "scrollIntoView", "selector": "#why", "block": "start", "note": "Why we built it" },
          { "type": "reel", "selector": "[data-reel=\"drift\"]", "frames": 4, "stepMs": 260, "holdMs": 900, "afterMs": 300, "note": "A demo should not drift", "narration": "Demos drift. Screens change, scripts go stale." },
          { "type": "highlight", "selector": "[data-word=\"product\"]", "holdMs": 1400, "afterMs": 200, "note": "…every time the product changes", "narration": "ScreenReel repairs itself instead." }
        ]},
        { "id": "tour-kpis", "enabled": true, "route": "./", "title": "Highlight product context", "talkingPoints": "Walk the KPIs one by one while the audience keeps its bearings.", "narration": "", "actions": [
          { "type": "scrollIntoView", "selector": "#kpis", "block": "start", "note": "Watch the runtime operate a real page" },
          { "type": "glow", "selector": ".kpi-card", "sequence": true, "count": 4, "stepMs": 750, "afterMs": 200, "note": "Revenue, margin, sell-through, stock", "narration": "It walks real KPIs — revenue, margin, sell-through, and stock." }
        ]},
        { "id": "tour-controls", "enabled": true, "route": "./", "title": "Work with real controls", "talkingPoints": "Type, select, toggle, and slide real inputs — then rock the demo.", "narration": "", "actions": [
          { "type": "scrollIntoView", "selector": "#form", "block": "start", "note": "Work with real controls" },
          { "type": "type", "selector": "#customer-name", "text": "Northstar Retail", "clearFirst": true, "charMs": 40, "afterMs": 250, "note": "Typing a customer name", "narration": "It types, selects, toggles, and slides — real controls, not mockups." },
          { "type": "set", "selector": "#region", "value": "West", "afterMs": 300, "note": "Choosing a region" },
          { "type": "toggle", "selector": "#priority", "checked": true, "afterMs": 300, "note": "Marking it a priority account" },
          { "type": "lever", "selector": "#confidence", "to": 95, "durMs": 950, "afterMs": 200, "note": "Confidence up to 95%" },
          { "type": "click", "selector": "#submit-control", "afterMs": 900, "note": "Rock the demo!", "narration": "Then it submits — for real." }
        ]},
        { "id": "tour-routes", "enabled": true, "route": "./", "title": "Continue across routes", "talkingPoints": "One click opens the next page and the flow keeps its place.", "narration": "", "actions": [
          { "type": "scrollIntoView", "selector": "[data-demo-id=\"final-card\"]", "block": "center", "note": "One flow, across pages" },
          { "type": "highlight", "selector": "[data-demo-id=\"final-card\"]", "holdMs": 1300, "note": "The flow survives a full navigation", "narration": "One flow can even cross pages." },
          { "type": "pointer", "selector": "[data-action=\"destination\"]", "afterMs": 700, "note": "Opening the next page" },
          { "type": "goto", "url": "destination.html?from=showcase", "note": "Navigating across routes" }
        ]},
        { "id": "tour-home", "enabled": true, "route": "destination.html?from=showcase", "title": "Back to the start", "talkingPoints": "The flow and notes continued across a full navigation, then the tour returns home.", "narration": "Same flow — it survived the whole navigation.", "actions": [
          { "type": "highlight", "selector": "[data-demo-id=\"destination-card\"]", "holdMs": 1300, "note": "The flow survived the navigation" },
          { "type": "pointer", "selector": "[data-demo-id=\"return-home\"]", "afterMs": 1000, "note": "Clicking return to ScreenReel" },
          { "type": "goto", "url": "./", "note": "Back to the ScreenReel home page" }
        ]}
      ]
    },
    {
      "id": "action-showcase", "name": "All actions showcase", "defaults": { "dwellMs": 1400, "settleMs": 500 }, "variables": { "company": { "label": "Company name", "default": "Northstar Retail" } },
      "scenes": [
        { "id": "action-tour", "enabled": true, "route": "./", "title": "Emphasise the product story", "talkingPoints": "Show a single target, a sequence, a spotlight, an anchored callout, and the code behind a step.", "actions": [
          { "type": "wait", "ms": 400 },
          { "type": "highlight", "definitionId": "highlight", "selector": "[data-demo-id=\"hero-card\"]", "holdMs": 700 },
          { "type": "glow", "definitionId": "highlight-sequence", "selector": ".kpi-card", "sequence": true, "count": 4, "stepMs": 450 },
          { "type": "spotlight", "selector": "[data-kpi=\"margin\"]", "holdMs": 700, "dim": 0.55 },
          { "type": "callout", "selector": "[data-kpi=\"sellthrough\"]", "text": "Callouts anchor the talking point.", "holdMs": 800 },
          { "type": "snippet", "selector": "[data-kpi=\"stock\"]", "label": "Snippet action", "code": "{ \"type\": \"snippet\", \"selector\": \"#kpis\" }", "holdMs": 900 },
          { "type": "flash", "selector": "[data-flash=\"changes\"]", "times": 2 },
          { "type": "reel", "selector": "[data-reel=\"drift\"]", "frames": 4, "stepMs": 200, "holdMs": 400 },
          { "type": "reveal", "selector": "[data-demo-id=\"cap-studio\"]", "src": "studio-shot.png", "holdMs": 900, "afterMs": 200 },
          { "type": "countdown", "from": 1, "stepMs": 400, "caption": "Countdown action" }
        ]},
        { "id": "interaction-tour", "enabled": true, "route": "./", "title": "Interact with real controls", "talkingPoints": "The same executor can click, hover, focus, type, set, toggle, and move sliders.", "actions": [
          { "type": "scrollIntoView", "selector": "#form", "block": "start", "durMs": 350 },
          { "type": "hover", "selector": "#customer-name", "holdMs": 250 },
          { "type": "focus", "selector": "#customer-name" },
          { "type": "type", "selector": "#customer-name", "text": "{{company}}", "clearFirst": true, "charMs": 18, "note": "Typing for {{company}}" },
          { "type": "set", "selector": "#region", "value": "West" },
          { "type": "toggle", "selector": "#priority", "checked": true },
          { "type": "lever", "selector": "#confidence", "to": 82, "durMs": 550 },
          { "type": "click", "selector": "#submit-control", "afterMs": 400 }
        ]},
        { "id": "navigation-tour", "enabled": true, "route": "./", "title": "Continue across routes", "talkingPoints": "Navigation retains active flow and scene position in project-scoped session storage.", "actions": [
          { "type": "scrollIntoView", "selector": "[data-demo-id=\"final-card\"]", "block": "center", "durMs": 450 },
          { "type": "goto", "url": "destination.html?from=showcase" }
        ]},
        { "id": "destination", "enabled": true, "route": "destination.html?from=showcase", "title": "Drag, pointer, and delayed state", "talkingPoints": "The remaining actions run against the fixtures on this second route: a drag board, a raw pointer target, delayed state, and a safe page function.", "actions": [
          { "type": "highlight", "selector": "[data-demo-id=\"destination-card\"]", "holdMs": 700 },
          { "type": "scrollIntoView", "selector": "[data-demo-id=\"fixtures\"]", "block": "start", "durMs": 350 },
          { "type": "drag", "selector": "[data-demo-id=\"drag-source\"]", "toSelector": "[data-demo-id=\"drag-destination\"]", "durMs": 600 },
          { "type": "pointer", "selector": "#pointer-target", "afterMs": 350 },
          { "type": "scroll", "definitionId": "scroll-by", "selector": "#activity-scroll", "mode": "relative", "direction": "down", "amount": 60, "unit": "viewportPercent", "durMs": 350 },
          { "type": "scroll", "definitionId": "scroll-edge", "selector": "#activity-scroll", "mode": "edge", "edge": "top", "durMs": 350 },
          { "type": "click", "selector": "[data-action=\"reveal-delayed\"]" },
          { "type": "waitFor", "selector": "#delayed-target", "condition": "visible", "timeoutMs": 3000 },
          { "type": "highlight", "selector": "#delayed-target", "holdMs": 650 },
          { "type": "call", "fn": "showScreenReelResult", "args": ["Safe page function called"], "cursorTo": "[data-demo-id=\"return-home\"]", "afterMs": 450 },
          { "type": "choice", "prompt": "Where to next?", "options": [ { "label": "Replay the story", "scene": "action-tour" }, { "label": "Real controls", "scene": "interaction-tour" } ], "timeoutMs": 8000, "defaultScene": "action-tour" }
        ]}
      ]
    }
  ]
}
